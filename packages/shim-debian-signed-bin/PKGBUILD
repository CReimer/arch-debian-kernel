package() {
    local archive member
    for archive in "${source[@]}"; do
        archive="${archive##*/}"
        member=$(bsdtar -tf "$srcdir/$archive" | sed -n '/^data\.tar/{p;q;}')
        bsdtar -xOf "$srcdir/$archive" "$member" | bsdtar -xf - -C "$pkgdir"
    done
}
