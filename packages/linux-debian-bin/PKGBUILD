package() {
    local archive member
    for archive in "${source[@]}"; do
        archive="${archive##*/}"
        member=$(bsdtar -tf "$srcdir/$archive" | sed -n '/^data\.tar/{p;q;}')
        bsdtar -xOf "$srcdir/$archive" "$member" | bsdtar -xf - -C "$pkgdir"
    done
    local modules="$pkgdir/usr/lib/modules/7.2.13+deb14-amd64"
    if [[ -d "$pkgdir/lib/modules" ]]; then
        install -d "$pkgdir/usr/lib"
        cp -a "$pkgdir/lib/modules" "$pkgdir/usr/lib/"
        rm -rf "$pkgdir/lib"
    fi
    if [[ ! -f "$modules/vmlinuz" ]]; then
        install -Dm644 "$pkgdir/boot/vmlinuz-7.2.13+deb14-amd64" "$modules/vmlinuz"
    fi
    printf '%s\n' "$pkgname" > "$modules/pkgbase"
    rm -rf "$pkgdir/boot"
    install -Dm644 "$startdir/linux-debian-bin.preset" "$pkgdir/etc/mkinitcpio.d/linux-debian-bin.preset"
}
